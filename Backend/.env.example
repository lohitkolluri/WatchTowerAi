# Database settings
# Use secure cloud MongoDB for production
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=watchtower
# Disable fallback mode in production
ENABLE_FALLBACK_MODE=false

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# Email settings
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
EMAIL_FROM=WatchTowerAI
ALERT_RECIPIENT=alert-recipient@example.com

