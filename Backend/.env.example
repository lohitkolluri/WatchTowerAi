# Database settings
DATABASE_URL=sqlite+aiosqlite:///./watchtower.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=watchtower
# Set to true to run without actual MongoDB connection (for development)
ENABLE_FALLBACK_MODE=false

# For MongoDB Atlas, use a connection string like:
# MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# API Keys
GEMINI_API_KEY=your-gemini-api-key

# Email settings
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=alerts@yourdomain.com
ALERT_RECIPIENT=ops@yourdomain.com
